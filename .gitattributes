# Finales de línea LF en el repositorio y en la copia de trabajo,
# sin importar la configuración de Git de cada máquina.
* text=auto eol=lf

# Scripts de Windows: necesitan CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binarios
*.png binary
*.jpg binary
*.pdf binary
*.db binary
