# Copiá este archivo como .env y completá con tus datos de MySQL.
# .env está en .gitignore: nunca subas credenciales reales al repositorio.
DB_HOST=localhost
DB_USER=usuario_mysql
DB_PASSWORD=cambiar_esta_clave
# Base de desarrollo. Los tests usan siempre biomaint_test (no se configura).
DB_NAME=biomaint
